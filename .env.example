# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and Stripe redirect URLs)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
# e.g., mongodb://localhost:27017/aic_db or MongoDB Atlas connection URI
MONGODB_URI=mongodb://localhost:27017/aic_database

# Stripe Configuration (Use Stripe Test Mode keys starting with sk_test_ and whsec_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# Admin Authentication Secret Key (Used in Bearer token or x-admin-key header)
ADMIN_API_KEY=your_secure_admin_api_key_here

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRES_IN=7d

# Contact Form & Email Delivery Configuration
# Destination email where contact inquiries will be delivered
CONTACT_DESTINATION_EMAIL=alhidayahislamiccenter26@gmail.com

# SMTP Server Credentials (e.g. Gmail SMTP, SendGrid, Mailgun, Amazon SES)
# For Gmail: Use smtp.gmail.com with port 587 and an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_account@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="Al Hidayah Islamic Center" <noreply@alhidayah.org>

